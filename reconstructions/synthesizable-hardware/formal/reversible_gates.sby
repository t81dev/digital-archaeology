# reversible_gates.sby
# SymbiYosys Formal Verification Configuration Script
# Validates control line preservation, information conservation, and gate inversion invariants.

[tasks]
bmc
prove

[options]
bmc: mode bmc
prove: mode prove
depth 20

[engines]
smtbmc z3

[script]
read -formal reversible_gates.sv
prep -top reversible_gates

[files]
reversible_gates.sv
